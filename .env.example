# DashScope / 百炼
DASHSCOPE_API_KEY=
ANSWER_MODEL=qwen3.6-plus
RERANK_MODEL=gte-rerank-v2
RERANK_FINAL_MODE=rerank_only

# OpenSearch
OPENSEARCH_ENDPOINT=
OPENSEARCH_INSTANCE_ID=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Company knowledge (separate from product tables; never rebuilt by the CLI)
KNOWLEDGE_TABLE=company_knowledge_hybrid
# Match this table exactly: company_knowledge_hybrid or <instance_id>_company_knowledge_hybrid
KNOWLEDGE_PUSH_DATASOURCE=
# Formal publication requires PostgreSQL + OSS; restore the catalogue before starting the server.
# Server catalogue: postgresql://... ; configure on the RAG server, never commit credentials
KNOWLEDGE_DATABASE_URL=
# Local development only when KNOWLEDGE_DATABASE_URL above is empty
KNOWLEDGE_DATA_DIR=
# Empty defaults to oss for PostgreSQL, inline for the local SQLite catalogue
KNOWLEDGE_BODY_STORAGE=
# Private knowledge bodies; empty connection fields reuse corresponding OSS_* values
KNOWLEDGE_OSS_ENDPOINT=
KNOWLEDGE_OSS_BUCKET=
KNOWLEDGE_OSS_ACCESS_KEY_ID=
KNOWLEDGE_OSS_ACCESS_KEY_SECRET=
KNOWLEDGE_OSS_PREFIX=company-knowledge/bodies/

# OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=
OSS_UPLOAD_PREFIX=rag/images/

# API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
